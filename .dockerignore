# .dockerignore for StaffEfficiency
# Prevents sending unnecessary files to Docker build context (faster builds)

# Dependencies
node_modules
npm-debug.log*

# Next.js build output
.next
out

# Production standalone output
standalone

# Environment files (never bake secrets into images)
.env
.env.local
.env.*.local
.env.development
.env.production

# Git
.git
.gitignore

# Docker (avoid recursive context)
Dockerfile
Dockerfile.*
docker-compose*
.dockerignore

# Documentation & misc
*.md
LICENSE
SECURITY.md
CONTRIBUTING.md
PROJECT_STATUS.md
docs/

# Test & coverage
coverage
test-results
playwright-report
*.log

# IDE / OS
.idea
.vscode
*.swp
*.swo
.DS_Store
Thumbs.db

# Prisma generated (will be generated inside container)
prisma/generated

# Misc
*.tgz
.cache
