# Supabase Cloud — скопируйте в .env.production.local
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Dashboard → Project Settings → API → service_role (секрет!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Dashboard → Project Settings → Database → Connection string → ORM / Prisma
# ВАЖНО: НЕ используйте хост db.[ref].supabase.co — Vercel не достучится (IPv6).
# Берите строки с pooler.supabase.com и логином postgres.[ref] (не просто postgres).

# DATABASE_URL — Transaction pooler, Mode: Transaction (порт 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# DIRECT_URL — Session pooler, Mode: Session (порт 5432, для prisma migrate deploy)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Миграции запускайте локально ДО деплоя: npm run deploy:setup

# Демо-пароль для seed-аккаунтов
DEMO_PASSWORD=Demo2026!